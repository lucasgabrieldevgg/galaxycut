{
  "name": "galaxycut-desktop",
  "version": "9.0.0",
  "description": "GalaxyCut — Editor de Vídeo para Criadores",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasgabrieldevgg/galaxycut.git",
    "directory": "desktop"
  },
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "app.galaxycut.desktop",
    "productName": "GalaxyCut",
    "copyright": "Copyright © 2026 Lucas Gabriel Dev",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "out/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "icons/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico",
      "artifactName": "GalaxyCut-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.icns",
      "category": "public.app-category.video"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
